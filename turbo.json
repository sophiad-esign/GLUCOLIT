{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "env": [
        "KIMI_VISION_MODEL",
        "OPENAI_VISION_MODEL",
        "KIMI_COMPANION_MODEL",
        "OPENAI_COMPANION_MODEL",
        "KIMI_LIFESTYLE_MODEL",
        "OPENAI_LIFESTYLE_MODEL"
      ],
      "dependsOn": ["^build"],
      "outputs": [".cache/tsbuildinfo.json", "dist/**", "build/**"]
    },
    "//#lint": {},
    "//#lint:fix": {
      "cache": false
    },
    "//#format": {},
    "//#format:fix": {
      "cache": false
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": false
    },
    "clean": {
      "cache": false
    },
    "setup": {
      "cache": false,
      "dependsOn": ["@workspace/db#db:setup"]
    },
    "test": {
      "outputs": ["coverage.json"]
    }
  },
  "globalEnv": ["DATABASE_URL", "PRODUCT_NAME", "URL", "DEFAULT_LOCALE"],
  "globalPassThroughEnv": [
    "GITHUB_CONTENT_BRANCH",
    "GITHUB_CONTENT_TOKEN",
    "GITHUB_REPOSITORY",
    "GITHUB_REPOSITORY_OWNER",
    "GITHUB_TOKEN",
    "KIMI_API_KEY",
    "KIMI_BASE_URL",
    "KIMI_MODEL",
    "NODE_ENV",
    "OPENAI_API_KEY",
    "OPENAI_MODEL",
    "SKIP_ENV_VALIDATION",
    "TARO_APP_API_BASE_URL",
    "npm_lifecycle_event"
  ]
}
